# -----------------------------------------------------------------------------
# [PARKO] Environment Configuration Template
# -----------------------------------------------------------------------------

# Server Configuration
PORT=4048
NODE_ENV=development

# Security
JWT_SECRET=your_super_secret_jwt_key_here

# Database Configuration
# If DB_HOST is empty, logic defaults to SQLite
DB_DIALECT=sqlite
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASS=password
# DB_NAME=inntek_ai_agent

# SSL for Cloud Deploys (Render/AWS)
DB_SSL=false
# DB_SSL_CA=...

# Feature Flags
DB_SYNC_DISABLED=false
