PORT=4048
NODE_ENV=preproduction

# Database (Docker MySQL)
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASS=password  # Debería venir de secrets en GH Actions
DB_NAME=inntek_ai_agent
DB_SSL=false      # El túnel suele ser interno entre contenedores

JWT_SECRET=preprod_jwt_secret
GEMINI_API_KEY=AIza...
VITE_API_URL=https://preprod-ia-agents-manager-api.inntek.cl/api
